# Copy this file to .env and fill in your own values.
# NEVER commit .env - it is gitignored. See README.md for how to load it.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/boilerplate?useSSL=false
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT signing secret - must be at least 32 characters (256 bits) for HS256.
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=replace_with_a_long_random_secret

# SMTP (mail notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
